{
  "name": "caustic-volume",
  "version": "2.2.0",
  "description": "Real-time water caustics in the browser, built on three.js: a light demo that runs almost anywhere (with a CPU fallback) and a heavy ray-traced sandbox. Each is a single HTML file.",
  "license": "MIT",
  "private": true,
  "keywords": [
    "threejs",
    "three.js",
    "webgl",
    "caustics",
    "water",
    "ray-tracing",
    "graphics",
    "shader",
    "simulation"
  ],
  "scripts": {
    "test": "node tools/test-lite.cjs --three=node_modules/three",
    "test:cpu": "node tools/test-lite.cjs --cpu",
    "test:sandbox": "node tools/test-sandbox.cjs --q=low --frames=3 --three=node_modules/three",
    "build": "node tools/build-sandbox.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=18"
  }
}
